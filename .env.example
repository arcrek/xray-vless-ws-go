PORT=127.0.0.1:8888
XRAY_UUID=
FAKE_SNI=api24-normal-alisg.tiktokv.com#Tiktok
WS_PATH=/tiktok4g
WS_HOST=trycloudflare.com
TRANSPORT=websocket
WEBHOOK_URL=
# Optional: use a named Cloudflare Tunnel (Zero Trust dashboard) instead of a
# quick/ephemeral tunnel. If set, cloudflared runs as:
#   cloudflared tunnel run --token <TUNNEL_TOKEN>
# The Public Hostname you configured on the dashboard IS your domain, so also
# set WS_HOST to that hostname (e.g. reverse.example.io.vn) — it will be used
# directly instead of scraping a *.trycloudflare.com URL from the logs.
TUNNEL_TOKEN=
# Optional: auto-deploy the Cloudflare Worker bridge (docs Bước 2+3) via the
# Cloudflare REST API instead of the dashboard. Set CLOUDFLARE_API_TOKEN
# (needs Workers Scripts:Edit, Workers KV Storage:Edit, Workers Routes:Edit
# (Zone), and Zone:Read (Zone) on DOMAIN's zone) together with DOMAIN (a zone
# apex already on the same Cloudflare account, e.g. example.com — NOT
# vless.example.com, the app prepends the "vless." prefix itself) to enable —
# both empty (default) means this is skipped entirely, WEBHOOK_URL above is
# used as-is. CLOUDFLARE_ACCOUNT_ID is only needed if the token can see more
# than one Cloudflare account. WORKER_PASSWORD is generated once below and
# becomes the deployed Worker's /setapi?password= value; leave blank to
# auto-generate — but note that unless a value is written back here, a blank
# WORKER_PASSWORD is re-randomized on every run (harmless — the redeployed
# script and the webhook always use the same freshly-generated value — but it
# means you can't manually curl /setapi with a password from a previous run).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DOMAIN=
WORKER_PASSWORD=
